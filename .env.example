# === Gateway Security & Rate Limiting ===
PORT=3000
PROXY_KEYS=your-secret-proxy-key
RATE_LIMIT_PER_MIN=0
REASONING_MODE=hide
ALLOWED_ORIGINS=*
BODY_LIMIT=50mb

# === Google Cloud Vertex AI (Gemini API Gateway) ===
# Option 1: Paste raw Service Account JSON string (or Base64-encoded JSON) directly in Render Environment Variables
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option 2: Path to Render Secret File (e.g. /etc/secrets/vertex-service-account.json)
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: Override GCP Project ID (auto-detected from Service Account JSON if omitted)
VERTEX_PROJECT_ID=
# Vertex AI Region (e.g. global, us-central1, europe-west4, asia-northeast1)
VERTEX_LOCATION=global
# Vertex AI Safety Threshold (BLOCK_NONE, OFF, BLOCK_ONLY_HIGH)
VERTEX_SAFETY_THRESHOLD=BLOCK_NONE

# === Optional: OpenAI-Compatible / NVIDIA NIM Upstream ===
UPSTREAM_BASE_URL=https://integrate.api.nvidia.com/v1
UPSTREAM_API_KEY=

# === Optional: Model Restrictions ===
MODEL_OVERRIDE=
MODEL_ALLOWLIST=
REQUEST_TIMEOUT_MS=120000
MAX_RETRIES=2
